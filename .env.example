# =============================================================================
# Environment configuration
# Copy to `.env` and fill in the values you need. Never commit `.env`.
# =============================================================================

# --- Required ---------------------------------------------------------------
# PostgreSQL connection string. Neon, RDS, Supabase, or a local server all work.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs JWTs. Use a long random string in production:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# --- AI provider (pick ONE primary, optional fallbacks) ----------------------
#
# The app is provider-agnostic. Set AI_PROVIDER to whichever service you have a
# key for; the request/response shapes, auth header, and JSON-mode handling are
# all adapted automatically. Nothing else in the codebase changes.
#
#   AI_PROVIDER   primary provider id (see table below)
#   AI_FALLBACKS  comma-separated ids tried in order when the primary fails
#   AI_MODEL      optional global model override (beats the per-provider default)
#   AI_DEBUG      "true" to log full request/response payloads
#
# Run `npm run ai:providers` to list all ids and which keys are detected, and
# `npm run ai:check` to send one real request per provider and see PASS/FAIL.
#
#   id          provider                    env var               default model
#   ---------------------------------------------------------------------------
#   mistral     Mistral AI                  MISTRAL_API_KEY       mistral-small-latest
#   openai      OpenAI (ChatGPT)            OPENAI_API_KEY        gpt-4o-mini
#   groq        Groq                        GROQ_API_KEY          llama-3.3-70b-versatile
#   gemini      Google Gemini               GEMINI_API_KEY        gemini-2.0-flash
#   grok        xAI Grok                    GROK_API_KEY          grok-2-latest
#   nvidia      NVIDIA NIM                  NVIDIA_API_KEY        meta/llama-3.3-70b-instruct
#   openrouter  OpenRouter                  OPENROUTER_API_KEY    openai/gpt-4o-mini
#   ollama      Ollama (local)              (none needed)         llama3.1
#   custom      Any OpenAI-compatible API   AI_API_KEY            AI_CUSTOM_MODEL
#
# Example: Groq primary, Gemini as backup.
#   AI_PROVIDER=groq
#   AI_FALLBACKS=gemini
#
AI_PROVIDER=mistral
AI_FALLBACKS=

# Primary provider key — set the one matching your AI_PROVIDER.
MISTRAL_API_KEY=

# Fallback provider keys (only needed for providers listed in AI_FALLBACKS).
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# --- Generic OpenAI-compatible escape hatch (AI_PROVIDER=custom) -------------
# Point these at any OpenAI-compatible endpoint: vLLM, Together, DeepSeek,
# Fireworks, LM Studio, Azure-style proxies, or a local mock.
AI_BASE_URL=
AI_API_KEY=
AI_CUSTOM_MODEL=

# --- Per-provider overrides (optional) ---------------------------------------
# Base URL: regional endpoints, gateways/proxies, Azure deployments, mocks.
# Model:    pin a specific model without changing the global AI_MODEL.
MISTRAL_BASE_URL=
MISTRAL_MODEL=
OPENAI_BASE_URL=
OPENAI_MODEL=
GROQ_BASE_URL=
GROQ_MODEL=
GEMINI_BASE_URL=
GEMINI_MODEL=
GROK_BASE_URL=
GROK_MODEL=
NVIDIA_BASE_URL=
NVIDIA_MODEL=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- AI tuning ---------------------------------------------------------------
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=700
